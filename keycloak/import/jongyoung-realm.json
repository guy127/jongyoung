{
  "realm": "jongyoung",
  "enabled": true,
  "displayName": "จองยัง",
  "registrationAllowed": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": false,
  "sslRequired": "none",
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 3600,
  "ssoSessionMaxLifespan": 36000,
  "clients": [
    {
      "clientId": "jongyoung-web",
      "name": "jongyoung web (next-auth)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "dev-only-jongyoung-web-secret",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://jongyoung.localhost/*",
        "http://localhost:3000/*"
      ],
      "webOrigins": [
        "http://jongyoung.localhost",
        "http://localhost:3000"
      ],
      "attributes": {
        "post.logout.redirect.uris": "http://jongyoung.localhost/*##http://localhost:3000/*"
      },
      "defaultClientScopes": ["web-origins", "profile", "roles", "email", "basic"],
      "protocolMappers": [
        {
          "name": "audience jongyoung-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "jongyoung-api",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
