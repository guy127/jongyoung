# คัดลอกเป็น .env ก่อนรัน:  cp .env.example .env
# ค่าทั้งหมดในไฟล์นี้เป็นค่าสำหรับเครื่อง dev เท่านั้น ห้ามใช้บน production

# PostgreSQL
POSTGRES_USER=jongyoung
POSTGRES_PASSWORD=jongyoung-dev-password
POSTGRES_DB=jongyoung

# Keycloak admin console (http://keycloak.jongyoung.localhost/admin)
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=admin

# client ที่ next-auth ใช้ — secret ต้องตรงกับ keycloak/import/jongyoung-realm.json
KEYCLOAK_CLIENT_ID=jongyoung-web
KEYCLOAK_CLIENT_SECRET=dev-only-jongyoung-web-secret

# next-auth ใช้เข้ารหัส session cookie (สร้างใหม่ได้ด้วย: openssl rand -base64 32)
NEXTAUTH_SECRET=dev-only-nextauth-secret-change-me
